# Local source build; run prepare-source.sh from the repository first.
pkgname=nekoinfo
pkgver=2.0.0
pkgrel=1
pkgdesc='Small native GTK4 system monitor'
arch=('any')
license=('MIT')
depends=('python' 'python-psutil' 'python-gobject' 'python-cairo' 'gtk4')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("nekoinfo-${pkgver}.tar.gz")
# prepare-source.sh writes the actual archive checksum here.
sha256sums=('64da25c6d2b17233d4cb41cffead6d66eab53a345281d7663fc9b225b40adb28')

build() {
  cd "$srcdir/nekoinfo-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$srcdir/nekoinfo-$pkgver"
  PYTHONPATH=src python -m unittest discover -s tests -v
}

package() {
  cd "$srcdir/nekoinfo-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
